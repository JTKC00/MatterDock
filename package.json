{
  "name": "matterdock",
  "version": "0.9.0",
  "private": true,
  "description": "Local-first workspace for matters, follow-ups and documents.",
  "author": "Snugzap",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "type": "module",
  "build": {
    "appId": "com.snugzap.matterdock",
    "productName": "MatterDock",
    "executableName": "MatterDock",
    "copyright": "Copyright © 2026 Snugzap",
    "publish": null,
    "artifactName": "MatterDock-${version}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MatterDock",
      "menuCategory": "MatterDock",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "runAfterFinish": true,
      "uninstallDisplayName": "MatterDock",
      "artifactName": "MatterDock-${version}-Setup.${ext}"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "install:electron": "npx --no-install install-electron --no",
    "package:win:dir": "npm run install:electron && node scripts/clean-release.mjs && npm run build && electron-builder --win dir --x64 --publish never",
    "package:win": "npm run install:electron && node scripts/clean-release.mjs && npm run build && electron-builder --win nsis --x64 --publish never",
    "verify:release": "node scripts/verify-release.mjs",
    "release:hash": "node scripts/release-hash.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "npm run install:electron && vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run install:electron && npm run build && playwright test",
    "test:e2e:packaged": "npm run package:win:dir && npx playwright test e2e/packaged.spec.ts",
    "release:win": "npm run typecheck && npm run lint && npm test && npm run test:e2e && npm run test:e2e:packaged && npm run package:win && npm run verify:release && npm run release:hash",
    "start": "electron-vite preview"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sql.js": "^1.14.2",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sql.js": "^1.4.11",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.16.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
